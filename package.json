{
  "name": "le-dojo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/build-cli.js",
    "start": "node build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "seed": "node scripts/build-cli.js && node build/cli/seed.js",
    "import-readings": "node scripts/build-cli.js && node build/cli/import-readings.js",
    "create-user": "node scripts/build-cli.js && node build/cli/create-user.js"
  },
  "dependencies": {
    "@node-rs/argon2": "2.0.2",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@fontsource/lora": "5.3.0",
    "@lucide/svelte": "1.60.0",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/web-push": "3.6.4",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.25.12",
    "pdfjs-dist": "5.4.624",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
