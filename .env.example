# Copier en .env sur le serveur (droits 600). Ne jamais commiter .env.
# Sous-domaine choisi, sans https:// (ex. dojo.mondomaine.fr)
DOJO_DOMAIN=
# Secret des sessions : je le génère sur le serveur avec  openssl rand -hex 32
SESSION_SECRET=
# V2 — rappels (Web Push). Générées sur le serveur avec :
#   docker compose run --rm --no-deps app node build/cli/generate-vapid.js
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
